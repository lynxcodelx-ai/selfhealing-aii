# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── AI Provider: "gemini" or "rule_based" ──
AI_PROVIDER=rule_based

# ── Gemini API (optional — set AI_PROVIDER=gemini to enable) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Healing Settings ──
AUTO_APPROVE_THRESHOLD=0.90
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=1.0
